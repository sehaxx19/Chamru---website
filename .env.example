# --- Database ---
# Postgres connection string. Free options that work well with Prisma:
# Neon (neon.tech) or Supabase (supabase.com).
DATABASE_URL="postgresql://user:password@host:5432/chamru?schema=public"

# --- NextAuth / Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- SMTP (for automated emails: inquiry confirmations, admin notifications) ---
# Works with Gmail (use an App Password, not your normal password),
# SendGrid, Mailgun, or any standard SMTP provider.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="travelwithchamru@gmail.com"
SMTP_PASSWORD=""
SMTP_FROM="Travel with Chamru <travelwithchamru@gmail.com>"
ADMIN_NOTIFICATION_EMAIL="travelwithchamru@gmail.com"

# --- AI Trip Planner ---
# Anthropic API key for the AI itinerary generator (console.anthropic.com)
ANTHROPIC_API_KEY=""

# --- Weather widget ---
# Free tier key from openweathermap.org
OPENWEATHER_API_KEY=""

# --- Database seeding (npm run db:seed) ---
# Seeds destinations/packages/vehicle/reviews/gallery from src/data/sample-data.ts.
# If ADMIN_EMAIL and ADMIN_PASSWORD are both set, also upserts an admin-role user
# with that email/password so you can sign in to /admin — this is currently the
# only way to get an admin account, since /api/register always creates CUSTOMER.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"
